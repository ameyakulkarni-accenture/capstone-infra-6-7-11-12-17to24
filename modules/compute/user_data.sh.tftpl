#!/bin/bash
dnf install -y nginx amazon-cloudwatch-agent

TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
ID=$(curl -sH "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -sH "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

echo "<h1>Served by $ID in $AZ</h1>" > /usr/share/nginx/html/index.html
echo "ok" > /usr/share/nginx/html/health

systemctl enable --now nginx

# Project 17: forward nginx logs to CloudWatch
cat > /opt/aws/amazon-cloudwatch-agent/etc/capstone-agent.json <<'CFG'
{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "${log_group_access}",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "${log_group_error}",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
CFG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/capstone-agent.json -s

# Project 19: back up nginx logs to S3 every 5 minutes
dnf install -y cronie
systemctl enable --now crond

cat > /usr/local/bin/backup-logs.sh <<'SCRIPT'
#!/bin/bash
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
ID=$(curl -sH "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
aws s3 sync /var/log/nginx "s3://${logs_bucket}/backups/$ID/" --region ap-northeast-3
SCRIPT
chmod +x /usr/local/bin/backup-logs.sh

echo "*/5 * * * * root /usr/local/bin/backup-logs.sh >> /var/log/backup-logs.log 2>&1" > /etc/cron.d/backup-logs
